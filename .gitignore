docs/
lanzamiento-del-modulo.md

# === Node.js ===
node_modules/
npm-debug.log*

# === macOS & System files ===
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# === Build, temp, and backup files ===
build/
bin/
*.pyc
*.pyo
*.swp
*.swo
*.tmp
*.log
*~
*.bak
*.orig

# === Android ===
android/build/
android/local.properties
android/.gradle/
android/.idea/
android/.DS_Store
android/.cxx/
android/.externalNativeBuild/
android/.settings/
android/.project
android/.classpath
android/.factorypath
android/.metadata/
